---
/**
 * 404 — the failing test.
 *
 * The hero runs a suite against itself and reports `0 failed`. This is the
 * one that failed, reported in the same runner's language: a red/green diff
 * of what was expected against what came back, then the routes that do
 * resolve. The requested path is filled in by the browser, so without JS the
 * page still reads correctly, just without naming the address.
 */
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;

const routes = [
  { href: base, label: "Home" },
  { href: `${base}speakers`, label: "Speakers" },
  { href: `${base}schedule`, label: "Schedule" },
  { href: `${base}venue`, label: "Venue" },
  { href: `${base}faq`, label: "FAQ" },
  { href: `${base}contact`, label: "Contact" },
];
---

<Layout
  title="Page not found - QA or the Highway"
  description="That page didn't resolve. Here are the ones that do."
>
  <section class="nf-section">
    <div class="container mx-auto max-w-8xl px-6 pt-14 pb-12 lg:pt-24 lg:pb-20">
      <div class="nf-stage">
        <h1 class="nf-diff">
          <span class="sr-only">Page not found.</span>
          <span class="nf-diff__row nf-diff__row--expected">
            <span class="nf-diff__mark" aria-hidden="true">-</span>
            <span class="nf-diff__label">Expected</span>
            <span class="nf-diff__value">200</span>
          </span>
          <span class="nf-diff__row nf-diff__row--received">
            <span class="nf-diff__mark" aria-hidden="true">+</span>
            <span class="nf-diff__label">Received</span>
            <span class="nf-diff__value">404</span>
          </span>
        </h1>

        <p class="nf-assertion">
          <svg class="nf-glyph nf-glyph--fail" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4.5 4.5 11.5 11.5 M11.5 4.5 4.5 11.5" />
          </svg>
          <span class="nf-assertion__name">route resolves</span>
          <span class="nf-assertion__at">at <span data-requested-path>this address</span></span>
        </p>

        <div class="nf-rule" aria-hidden="true"><span class="nf-rule__fill"></span></div>

        <p class="nf-lede">This page doesn't exist. These do:</p>

        <ul class="nf-routes">
          {routes.map((route, i) => (
            <li style={`--d:${180 + i * 55}ms`}>
              <a href={route.href} class="nf-route">
                <svg class="nf-glyph nf-glyph--pass" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3.5 8.5 6.5 11.5 12.5 4.5" />
                </svg>
                <span class="nf-route__path">{route.href}</span>
                <span class="nf-route__label">{route.label}</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="nf-status">
          <span class="nf-status__dot"></span>
          <span class="nf-status__state">run finished</span>
          <span class="nf-status__counts">
            <span class="nf-status__fail">1 failed</span>
            <span class="nf-status__pass">0 passed</span>
          </span>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const slot = document.querySelector("[data-requested-path]");
    if (!slot) return;
    const raw = window.location.pathname + window.location.search;
    if (!raw || raw === "/") return;
    /* Text only, never markup, and capped — a crafted URL can neither
       inject into the page nor blow out the layout. */
    slot.textContent = raw.length > 120 ? raw.slice(0, 119) + "\u2026" : raw;
  })();
</script>

<style>
  .nf-section {
    position: relative;
    color: var(--color-dark);
  }
  .nf-stage {
    --nf-step: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ---- the diff ---- */
  .nf-diff {
    display: grid;
    gap: 0.15em;
    font-family: "Work Sans", ui-sans-serif, system-ui, sans-serif;
    font-size: 2.25rem;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  @media (min-width: 640px) { .nf-diff { font-size: 3rem; } }
  @media (min-width: 768px) { .nf-diff { font-size: 3.75rem; } }
  @media (min-width: 1280px) { .nf-diff { font-size: 4.5rem; } }
  @media (min-width: 1536px) { .nf-diff { font-size: 5rem; } }

  .nf-diff__row {
    display: grid;
    grid-template-columns: 0.7em minmax(0, auto) minmax(0, 1fr);
    align-items: baseline;
    gap: 0.28em;
  }
  .nf-diff__row--expected { color: var(--color-pass-ink); }
  .nf-diff__row--received { color: var(--color-fail-ink); }

  .nf-diff__mark {
    font-size: 0.5em;
    font-weight: 700;
    opacity: 0.6;
    align-self: center;
  }
  .nf-diff__label {
    font-size: 0.4em;
    font-weight: 700;
    letter-spacing: 0.12em;
    align-self: center;
  }
  .nf-diff__value {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* ---- the failing assertion ---- */
  .nf-assertion {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    margin-top: 2rem;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.9375rem;
  }
  .nf-assertion__name {
    color: var(--color-fail-ink);
    font-weight: 600;
  }
  .nf-assertion__at {
    color: color-mix(in srgb, var(--color-dark) 72%, transparent);
    overflow-wrap: anywhere;
  }
  .nf-assertion__at [data-requested-path] {
    color: var(--color-dark);
    font-weight: 600;
  }

  /* ---- the run, as one failed segment ---- */
  .nf-rule {
    height: 4px;
    margin-top: 2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-dark) 12%, transparent);
    overflow: hidden;
  }
  .nf-rule__fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-fail);
    transform-origin: left center;
  }

  /* ---- recovery ---- */
  .nf-lede {
    margin-top: 2.25rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  @media (min-width: 768px) { .nf-lede { font-size: 1.375rem; } }

  .nf-routes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.25rem 1.5rem;
    margin-top: 1rem;
    max-width: 62rem;
    list-style: none;
    padding: 0;
  }
  .nf-route {
    display: grid;
    grid-template-columns: 1rem minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.75rem;
    margin-left: -0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
  }
  .nf-route__path {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .nf-route__label {
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--color-dark) 70%, transparent);
  }
  .nf-route:hover,
  .nf-route:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
  .nf-route:hover .nf-route__path,
  .nf-route:focus-visible .nf-route__path {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .nf-route:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ---- runner status, matching the hero ---- */
  .nf-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 2.75rem;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-dark) 74%, transparent);
  }
  .nf-status__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-fail);
    flex: none;
  }
  .nf-status__counts { display: flex; gap: 1rem; }
  .nf-status__fail { color: var(--color-fail-ink); font-weight: 600; }

  /* ---- glyphs ---- */
  .nf-glyph {
    width: 1rem;
    height: 1rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nf-glyph--fail { color: var(--color-fail); width: 1.05rem; height: 1.05rem; }
  .nf-glyph--pass { color: var(--color-pass); }

  /* ---- one authored moment: the report arrives the way output streams ---- */
  @media (prefers-reduced-motion: no-preference) {
    .nf-diff__row,
    .nf-assertion,
    .nf-lede,
    .nf-routes li {
      animation: nf-in 460ms var(--nf-step) both;
    }
    .nf-diff__row--expected { animation-delay: 0ms; }
    .nf-diff__row--received { animation-delay: 190ms; }
    .nf-assertion { animation-delay: 360ms; }
    .nf-lede { animation-delay: 480ms; }
    .nf-routes li { animation-delay: var(--d); }

    .nf-rule__fill {
      animation: nf-rule 520ms var(--nf-step) 300ms both;
    }
    .nf-status__dot {
      animation: nf-pulse 2.4s ease-in-out 1.2s infinite;
    }
    .nf-route {
      transition:
        background-color 160ms linear,
        transform 160ms var(--nf-step);
    }
    .nf-route:hover { transform: translateX(2px); }
  }

  @keyframes nf-in {
    from { opacity: 0; transform: translateY(0.35em); }
  }
  @keyframes nf-rule {
    from { transform: scaleX(0); }
  }
  @keyframes nf-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.28; }
  }
</style>
